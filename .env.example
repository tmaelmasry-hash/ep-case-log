# Copy to .env, or run `npm run setup` which creates it. Never commit .env.
# Required: long random string (≥ 32 characters); signs the session cookies.
SESSION_SECRET=
# file (data/registry.json, default) | memory (throw-away)
STORE=file
DATA_DIR=data
PORT=8787
# 127.0.0.1 = this computer only. 0.0.0.0 = also other devices on the network (then serve it over HTTPS).
HOST=127.0.0.1
# Session cookies need HTTPS or localhost. Set 0 only for a plain-http test on a LAN address.
SECURE_COOKIES=1

# ── Google Sheet (phase 4). STORE=sheets uses the registry Sheet through the Apps Script web app. ──
# APPS_SCRIPT_URL = the web app address ending in /exec (from Deploy → New deployment). Not a password, but keep it private.
# GATEWAY_SECRET  = created by `npm run sheets -- secret`; never share it or put it in git.
# SHEETS_TARGET=test points at the TEST Sheet (synthetic data only).
# STORE=sheets
# APPS_SCRIPT_URL=
# GATEWAY_SECRET=
