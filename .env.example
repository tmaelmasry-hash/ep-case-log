# Copy to .env, or run `npm run setup` which creates it. Never commit .env.
# Required: long random string (≥ 32 characters); signs the session cookies.
SESSION_SECRET=
# file (data/registry.json, default) | memory (throw-away)
STORE=file
DATA_DIR=data
PORT=8787
# 127.0.0.1 = this computer only. 0.0.0.0 = also other devices on the network (then serve it over HTTPS).
HOST=127.0.0.1
# Session cookies need HTTPS or localhost. Set 0 only for a plain-http test on a LAN address.
SECURE_COOKIES=1
