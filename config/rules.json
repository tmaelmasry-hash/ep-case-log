{
 "_note": "Dynamic-form rules (merge step M-1, DECISIONS M-1). Evaluated by public/js/rules.js in the browser and on the server. Only rules taken from the dictionary / frozen spec text (SOURCE_EXPLICIT) or approved by the owner (OWNER_APPROVED) are listed; open ones stay in docs/merge/DYNAMIC_RULES_MATRIX.tsv. A hidden field is never stored as N/A; a value that stops fitting is removed only after the person confirms. 'enabled': false switches every rule off.",
 "version": "rules/r3-2026-10-23",
 "enabled": true,
 "rules": [
  {
   "id": "DR-KAMC-01",
   "version": 1,
   "status": "OWNER_APPROVED",
   "source": "owner field review 24 Oct 2026: first or redo only for ablation, not device procedures",
   "target": "EP_PROCEDURES.first_or_redo",
   "effect": "show_when",
   "when": {
    "component": ["AVNRT", "AVRT_WPW", "AT_SVT", "AF", "FLUTTER", "PVC", "VT_VF", "AVJ_ABLATION"]
   }
  },
  {
   "id": "DR-AF-01",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec CANON_AF_ENDPOINT_V1 I1",
   "target": "EP_PROCEDURES.first_or_redo",
   "effect": "offer_when",
   "code": "NOT_APPLICABLE",
   "when": {
    "not": {
     "component": [
      "AF"
     ]
    }
   }
  },
  {
   "id": "DR-AF-03",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I2",
   "target": "AF_ABLATIONS.pv_status_at_case_end",
   "effect": "offer_when",
   "code": "NO_RECONNECTION_CONFIRMED",
   "when": {
    "field": "EP_PROCEDURES.first_or_redo",
    "in": [
     "REDO"
    ]
   }
  },
  {
   "id": "DR-AF-04a",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I3",
   "target": "AF_ABLATIONS.pv_status_at_case_end",
   "effect": "offer_when",
   "code": "ALL_TARGET_PVS_ISOLATED",
   "when": {
    "not": {
     "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
     "eq": false
    }
   }
  },
  {
   "id": "DR-AF-04b",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I3",
   "target": "AF_ABLATIONS.pv_status_at_case_end",
   "effect": "offer_when",
   "code": "PARTIAL_ISOLATION",
   "when": {
    "not": {
     "all": [
      {
       "field": "EP_PROCEDURES.first_or_redo",
       "in": [
        "FIRST"
       ]
      },
      {
       "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
       "eq": false
      }
     ]
    }
   }
  },
  {
   "id": "DR-AF-05",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I4, I5",
   "target": "AF_ABLATIONS.pv_reconnection_present_at_redo",
   "effect": "show_when",
   "when": {
    "all": [
     {
      "field": "EP_PROCEDURES.first_or_redo",
      "in": [
       "REDO"
      ]
     },
     {
      "field": "AF_ABLATIONS.pv_status_at_case_end",
      "in": [
       "ALL_TARGET_PVS_ISOLATED",
       "PARTIAL_ISOLATION",
       "NOT_ISOLATED",
       "NO_RECONNECTION_CONFIRMED"
      ]
     }
    ]
   }
  },
  {
   "id": "DR-AF-05b",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I5 (NO_RECONNECTION_CONFIRMED forces FALSE)",
   "target": "AF_ABLATIONS.pv_reconnection_present_at_redo",
   "effect": "offer_when",
   "code": "true",
   "when": {
    "not": {
     "field": "AF_ABLATIONS.pv_status_at_case_end",
     "in": [
      "NO_RECONNECTION_CONFIRMED"
     ]
    }
   }
  },
  {
   "id": "DR-AF-06",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I4, I5",
   "target": "AF_ABLATIONS.reconnected_pv_count",
   "effect": "show_when",
   "when": {
    "all": [
     {
      "field": "EP_PROCEDURES.first_or_redo",
      "in": [
       "REDO"
      ]
     },
     {
      "field": "AF_ABLATIONS.pv_reconnection_present_at_redo",
      "eq": true
     }
    ]
   }
  },
  {
   "id": "DR-AF-06b",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I5 (a count of ZERO is an error)",
   "target": "AF_ABLATIONS.reconnected_pv_count",
   "effect": "min",
   "value": 1
  },
  {
   "id": "DR-AF-07",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I6",
   "target": "AF_ABLATIONS.additional_ablation_types",
   "effect": "show_when",
   "when": {
    "field": "AF_ABLATIONS.additional_ablation_beyond_pvi",
    "eq": true
   }
  },
  {
   "id": "DR-AF-08",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I8",
   "target": "AF_ABLATIONS.pvi_block_confirmation",
   "effect": "show_when",
   "when": {
    "field": "AF_ABLATIONS.pv_status_at_case_end",
    "in": [
     "ALL_TARGET_PVS_ISOLATED",
     "PARTIAL_ISOLATION",
     "NO_RECONNECTION_CONFIRMED"
    ]
   }
  },
  {
   "id": "DR-AF-09-E1",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec E1 (shown as a check, saving not blocked)",
   "target": "AF_ABLATIONS.acute_af_endpoint",
   "effect": "warn_when",
   "message": "Complete PVI / re-isolation needs PVI attempted = Yes and every target vein isolated.",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.acute_af_endpoint",
      "in": [
       "COMPLETE_PVI_OR_REISOLATION"
      ]
     },
     {
      "any": [
       {
        "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
        "eq": false
       },
       {
        "not": {
         "field": "AF_ABLATIONS.pv_status_at_case_end",
         "in": [
          "ALL_TARGET_PVS_ISOLATED"
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": "DR-AF-09-E2",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec E2 (shown as a check, saving not blocked)",
   "target": "AF_ABLATIONS.acute_af_endpoint",
   "effect": "warn_when",
   "message": "\"No reconnection, no new PVI required\" needs a redo with no PVI attempted, no reconnection confirmed and no additional ablation.",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.acute_af_endpoint",
      "in": [
       "NO_RECONNECTION_NO_NEW_PVI_REQUIRED"
      ]
     },
     {
      "any": [
       {
        "field": "EP_PROCEDURES.first_or_redo",
        "in": [
         "FIRST"
        ]
       },
       {
        "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
        "eq": true
       },
       {
        "not": {
         "field": "AF_ABLATIONS.pv_status_at_case_end",
         "in": [
          "NO_RECONNECTION_CONFIRMED"
         ]
        }
       },
       {
        "field": "AF_ABLATIONS.additional_ablation_beyond_pvi",
        "eq": true
       }
      ]
     }
    ]
   }
  },
  {
   "id": "DR-AF-09-E3",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec E3 (shown as a check, saving not blocked)",
   "target": "AF_ABLATIONS.acute_af_endpoint",
   "effect": "warn_when",
   "message": "\"Non-PV target achieved\" needs additional ablation = Yes and a complete PVI (or, at a redo, no reconnection confirmed).",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.acute_af_endpoint",
      "in": [
       "NON_PV_TARGET_ACHIEVED"
      ]
     },
     {
      "any": [
       {
        "field": "AF_ABLATIONS.additional_ablation_beyond_pvi",
        "eq": false
       },
       {
        "not": {
         "any": [
          {
           "all": [
            {
             "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
             "eq": true
            },
            {
             "field": "AF_ABLATIONS.pv_status_at_case_end",
             "in": [
              "ALL_TARGET_PVS_ISOLATED"
             ]
            }
           ]
          },
          {
           "all": [
            {
             "field": "EP_PROCEDURES.first_or_redo",
             "in": [
              "REDO"
             ]
            },
            {
             "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
             "eq": false
            },
            {
             "field": "AF_ABLATIONS.pv_status_at_case_end",
             "in": [
              "NO_RECONNECTION_CONFIRMED"
             ]
            }
           ]
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": "DR-AF-09-E4",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec E4 (shown as a check, saving not blocked)",
   "target": "AF_ABLATIONS.acute_af_endpoint",
   "effect": "warn_when",
   "message": "\"Failed / aborted\" does not fit a case that ended with every target vein isolated.",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.acute_af_endpoint",
      "in": [
       "FAILED_ABORTED"
      ]
     },
     {
      "field": "AF_ABLATIONS.pv_status_at_case_end",
      "in": [
       "ALL_TARGET_PVS_ISOLATED",
       "NO_RECONNECTION_CONFIRMED"
      ]
     }
    ]
   }
  },
  {
   "id": "DR-AF-09-E5",
   "version": 1,
   "status": "OWNER_APPROVED",
   "source": "spec E5 (clinical approval OUTSTANDING in the spec; owner 21 Oct: warning only)",
   "target": "AF_ABLATIONS.acute_af_endpoint",
   "effect": "warn_when",
   "message": "\"Partial\" is unusual here: every target vein is isolated and there was no additional ablation.",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.acute_af_endpoint",
      "in": [
       "PARTIAL"
      ]
     },
     {
      "field": "AF_ABLATIONS.additional_ablation_beyond_pvi",
      "eq": false
     },
     {
      "any": [
       {
        "all": [
         {
          "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
          "eq": true
         },
         {
          "field": "AF_ABLATIONS.pv_status_at_case_end",
          "in": [
           "ALL_TARGET_PVS_ISOLATED"
          ]
         }
        ]
       },
       {
        "all": [
         {
          "field": "EP_PROCEDURES.first_or_redo",
          "in": [
           "REDO"
          ]
         },
         {
          "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
          "eq": false
         },
         {
          "field": "AF_ABLATIONS.pv_status_at_case_end",
          "in": [
           "NO_RECONNECTION_CONFIRMED"
          ]
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "id": "DR-AF-09-I7",
   "version": 1,
   "status": "SOURCE_EXPLICIT",
   "source": "spec I7 (shown as a check, saving not blocked)",
   "target": "AF_ABLATIONS.acute_af_endpoint",
   "effect": "warn_when",
   "message": "This endpoint needs something attempted: PVI attempted = Yes, or additional ablation = Yes.",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.acute_af_endpoint",
      "in": [
       "COMPLETE_PVI_OR_REISOLATION",
       "NON_PV_TARGET_ACHIEVED",
       "PARTIAL"
      ]
     },
     {
      "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
      "eq": false
     },
     {
      "field": "AF_ABLATIONS.additional_ablation_beyond_pvi",
      "eq": false
     }
    ]
   }
  },
  {
   "id": "DR-AF-I3B",
   "version": 1,
   "status": "OWNER_APPROVED",
   "source": "spec I3B (clinical approval OUTSTANDING in the spec; owner 21 Oct: warning only)",
   "target": "AF_ABLATIONS.pv_status_at_case_end",
   "effect": "warn_when",
   "message": "\"No reconnection confirmed\" usually means no re-isolation was attempted; PVI attempted is Yes.",
   "when": {
    "all": [
     {
      "field": "AF_ABLATIONS.pv_status_at_case_end",
      "in": [
       "NO_RECONNECTION_CONFIRMED"
      ]
     },
     {
      "field": "AF_ABLATIONS.pvi_or_reisolation_attempted",
      "eq": true
     }
    ]
   }
  },
