{
 "_note": "Site rules copied from EP Workspace config/site.json (mrn, timezone, registry_basis_default). Edit here to change them.",
 "timezone": "Asia/Riyadh",
 "mrn": {
  "storage": "text",
  "normalize": [
   "trim",
   "arabic_indic_digits_to_ascii",
   "persian_digits_to_ascii",
   "remove_inner_spaces_only_if_all_digits"
  ],
  "hard_rule": {
   "regex": "^\\d{7}$",
   "message": "MRN must be exactly 7 digits."
  },
  "soft_rule": {
   "regex": "^(10\\d|11\\d|120)\\d{4}$",
   "message": "Unusual MRN prefix (expected 1000000–1209999). Check before adding."
  },
  "_soft_rule_reason": "KAMC MRNs started at 100xxxx and currently reach 120xxxx. The soft rule warns but does not block, so 121xxxx will still be accepted when it appears. Update in Settings."
 },
 "registry_basis_default": "CLINICAL_QI",
 "dashboard": {
  "_note": "Copied from EP Workspace config/site.json dashboard (owner-confirmed 16 Oct 2026, DECISIONS P6-13). Counts only. In this app the clinical counts are per procedure (case = episode with several procedures).",
  "stale_days": 14,
  "procedure_date_field": "EP_PROCEDURES.procedure_start_datetime",
  "pilgrim_field": "EP_EPISODES.pilgrim_status",
  "complications_field": "EXT_PROCEDURE_REVIEW.complications_reviewed",
  "complications_present_code": "PRESENT",
  "complications_reviewed_codes": [
   "NONE_DOCUMENTED",
   "PRESENT"
  ],
  "acute_success": {
   "AF_ABLATION": {
    "field": "AF_ABLATIONS.acute_af_endpoint",
    "success": [
     "COMPLETE_PVI_OR_REISOLATION",
